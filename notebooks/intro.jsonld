    {
      "@id": "https://notebook.semantic.consulting/notebook1/#introducing-turtle",
      "@type": "sembook:Lab",
      "sembook:label": "Two Syntaxes, One Graph",
      "sembook:cssClass": "grid grid-cols-2 grid-rows-[1fr] h-screen w-full",
      "sembook:init": {},
      "sembook:panels": [
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#introducing-turtle-jsonld",
          "@type": "sembook:JsonLdPanel",
          "sembook:label": "JSON-LD",
          "sembook:cssClass": "overflow-hidden flex flex-col sem-divider-r",
          "sembook:initialContent": "{\n  \"@context\": {\n    \"@base\": \"https://catalog.example.net/\",\n    \"schema\": \"http://schema.org/\",\n    \"id\": \"@id\"\n  },\n  \"id\": \"/book/979-8868804090\",\n  \"@type\": \"schema:Book\",\n  \"schema:name\": \"Mastering Software Architecture\",\n  \"schema:isbn\": \"979-8868804090\",\n  \"schema:datePublished\": \"2025\",\n  \"schema:author\": {\n    \"id\": \"https://w3id.org/people/michael\",\n    \"schema:name\": \"Michael Carducci\"\n  }\n}"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#introducing-turtle-turtle",
          "@type": "sembook:TurtlePanel",
          "sembook:label": "Turtle",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:sparql": "SELECT ?s ?p ?o WHERE { GRAPH <https://notebook.semantic.consulting/notebook1/#introducing-turtle> { ?s ?p ?o } }"
        }
      ]
    },
    {
      "@id": "https://notebook.semantic.consulting/notebook1/#asserting-triples",
      "@type": "sembook:Lab",
      "sembook:label": "Defining Terms",
      "sembook:cssClass": "grid grid-rows-[40vh_60vh] h-screen w-full",
      "sembook:init": {},
      "sembook:panels": [
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#asserting-triples-writer",
          "@type": "sembook:TurtleWriterPanel",
          "sembook:label": "Turtle",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:initialContent": "@prefix ex: <https://example.com/ns#> .\n@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .\n@prefix schema: <http://schema.org/> .\n\n# ── Our ontology ──────────────────────────────────────\n\nex:title a rdf:Property ;\n    rdfs:range xsd:string .\n\n# Still to define (every term the day has used so far):\n#   ex:published  ex:author  ex:name  ex:affiliation\n#   ex:isbn  ex:about  ex:positionHeld  ex:jobTitle\n"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#asserting-triples-tabs",
          "@type": "sembook:TabsPanel",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:panels": [
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#asserting-triples-vocabulary",
              "@type": "sembook:VocabularyPanel",
              "sembook:label": "Vocabulary",
              "sembook:scope": { "@id": "sembook:CumulativeScope" }
            },
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#asserting-triples-local-graph",
              "@type": "sembook:GraphPanel",
              "sembook:label": "Local Graph",
              "sembook:scope": { "@id": "sembook:LocalScope" },
              "sembook:sparql": "SELECT ?s ?p ?o WHERE { GRAPH ?g { ?s ?p ?o } VALUES ?g { <https://notebook.semantic.consulting/notebook1/#asserting-triples> } }"
            }
          ]
        }
      ]
    },
    {
      "@id": "https://notebook.semantic.consulting/notebook1/#labels-and-comments",
      "@type": "sembook:Lab",
      "sembook:label": "Labels and Comments",
      "sembook:cssClass": "grid grid-rows-[40vh_60vh] h-screen w-full",
      "sembook:init": {},
      "sembook:panels": [
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#labels-and-comments-writer",
          "@type": "sembook:TurtleWriterPanel",
          "sembook:label": "Turtle",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:initialContent": "@prefix ex: <https://example.com/ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n\n# ── Our ontology ──────────────────────────────────────\n\nex:title\n    rdfs:label \"\"@en-US .\n\nex:published\n    rdfs:label \"\"@en-US .\n\nex:author\n    rdfs:label \"\"@en-US .\n\nex:name\n    rdfs:label \"\"@en-US .\n\nex:affiliation\n    rdfs:label \"\"@en-US .\n\nex:isbn\n    rdfs:label \"\"@en-US .\n\nex:about\n    rdfs:label \"\"@en-US .\n\nex:positionHeld\n    rdfs:label \"\"@en-US .\n\nex:jobTitle\n    rdfs:label \"\"@en-US .\n"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#labels-and-comments-tabs",
          "@type": "sembook:TabsPanel",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:panels": [
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#labels-and-comments-vocabulary",
              "@type": "sembook:VocabularyPanel",
              "sembook:label": "Vocabulary",
              "sembook:scope": {
                "@id": "sembook:CumulativeScope"
              }
            },
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#labels-and-comments-local-graph",
              "@type": "sembook:GraphPanel",
              "sembook:label": "Local Graph",
              "sembook:scope": {
                "@id": "sembook:LocalScope"
              },
              "sembook:sparql": "SELECT ?s ?p ?o WHERE { GRAPH ?g { ?s ?p ?o } VALUES ?g { <https://notebook.semantic.consulting/notebook1/#labels-and-comments> } }"
            }
          ]
        }
      ]
    },
    {
      "@id": "https://notebook.semantic.consulting/notebook1/#defining-classes",
      "@type": "sembook:Lab",
      "sembook:label": "Classes and Subclasses",
      "sembook:cssClass": "grid grid-rows-[40vh_60vh] h-screen w-full",
      "sembook:init": {},
      "sembook:panels": [
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#defining-classes-writer",
          "@type": "sembook:TurtleWriterPanel",
          "sembook:label": "Turtle",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:initialContent": "@prefix ex: <https://example.com/ns#> .\n@prefix schema: <http://schema.org/> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n\n# ── Our ontology ──────────────────────────────────────\n\nex:Book a rdfs:Class ;\n    rdfs:label \"Book\" ;\n    rdfs:comment \"A published written work\" .\n\n# Our world has met more kinds of things than the graph knows about.\n# Declare them, and say how they relate:\n#\n#   ex:Author            who counts? What else is an Author?\n#   schema:Person        every Author is one\n#   ex:Organization      Hofstadter has an affiliation, to what kind of thing?\n#   schema:CreativeWork  a Book is one; what else is?\n"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#defining-classes-tabs",
          "@type": "sembook:TabsPanel",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:panels": [
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#defining-classes-vocabulary",
              "@type": "sembook:VocabularyPanel",
              "sembook:label": "Vocabulary",
              "sembook:scope": {
                "@id": "sembook:CumulativeScope"
              }
            },
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#defining-classes-local-graph",
              "@type": "sembook:GraphPanel",
              "sembook:label": "Local Graph",
              "sembook:scope": {
                "@id": "sembook:LocalScope"
              },
              "sembook:sparql": "SELECT ?s ?p ?o WHERE { GRAPH ?g { ?s ?p ?o } VALUES ?g { <https://notebook.semantic.consulting/notebook1/#defining-classes> } }"
            }
          ]
        }
      ]
    },
    {
      "@id": "https://notebook.semantic.consulting/notebook1/#domain-and-range",
      "@type": "sembook:Lab",
      "sembook:label": "Domain and Range",
      "sembook:cssClass": "grid grid-rows-[40vh_60vh] h-screen w-full",
      "sembook:init": {},
      "sembook:panels": [
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#domain-and-range-writer",
          "@type": "sembook:TurtleWriterPanel",
          "sembook:label": "Turtle",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:initialContent": "@prefix ex: <https://example.com/ns#> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n\n# What kind of thing has an ISBN?\n# Then: what kind of thing is the value of ex:author? Of ex:affiliation?\n"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#domain-and-range-tabs",
          "@type": "sembook:TabsPanel",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:panels": [
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#domain-and-range-vocabulary",
              "@type": "sembook:VocabularyPanel",
              "sembook:label": "Vocabulary",
              "sembook:scope": {
                "@id": "sembook:CumulativeScope"
              }
            },
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#domain-and-range-entities",
              "@type": "sembook:EntityPanel",
              "sembook:defaultScope": "all",
            "sembook:label": "Entities",
              "sembook:scope": {
                "@id": "sembook:CumulativeScope"
              },
              "sembook:sparql": "SELECT DISTINCT ?class ?parentClass ?instance ?instanceLabel ?classLabel WHERE { GRAPH ?g { VALUES ?g { <https://notebook.semantic.consulting/notebook1/#domain-and-range> } { { ?anyInstance a ?class } UNION { ?class a <http://www.w3.org/2000/01/rdf-schema#Class> } UNION { ?class a <http://www.w3.org/2002/07/owl#Class> } UNION { ?class <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?anyParent } UNION { ?anySub <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?class } } FILTER(!isBlank(?class)) FILTER(!STRSTARTS(STR(?class), \"https://notebook.semantic.consulting/vocab#\")) OPTIONAL { ?class <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?parentClass . FILTER(!STRSTARTS(STR(?parentClass), \"https://notebook.semantic.consulting/vocab#\")) } OPTIONAL { ?instance a ?class . FILTER(!isBlank(?instance)) OPTIONAL { ?instance <http://www.w3.org/2000/01/rdf-schema#label> ?instanceLabel } } OPTIONAL { ?class <http://www.w3.org/2000/01/rdf-schema#label> ?classLabel } } }"
            }
          ]
        }
      ]
    },
    {
      "@id": "https://notebook.semantic.consulting/notebook1/#merging-vocabularies",
      "@type": "sembook:Lab",
      "sembook:label": "Merging Vocabularies",
      "sembook:cssClass": "grid grid-rows-[40vh_60vh] h-screen w-full",
      "sembook:init": {},
      "sembook:panels": [
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#merging-vocabularies-writer",
          "@type": "sembook:TurtleWriterPanel",
          "sembook:label": "Turtle",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:initialContent": "@prefix ex: <https://example.com/ns#> .\n@prefix schema: <http://schema.org/> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n\n# ── Our ontology (alignments) ──────────────────────────\n\n# Every title is a name. Not every name is a title.\n# One-way containment — the graph already has a word for that:\n\nex:title rdfs:subPropertyOf schema:name .\n\n# What else did we learn today? Align the rest:\n#\n#   ex:author  and  schema:author   — every one of ours is one of theirs… and?\n#   ex:Book    and  schema:Book     — classes too: rdfs:subClassOf, both ways?\n#   ex:isbn    and  schema:isbn     — careful: is this one-way… or both?\n"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#merging-vocabularies-tabs",
          "@type": "sembook:TabsPanel",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:panels": [
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#merging-vocabularies-vocabulary",
              "@type": "sembook:VocabularyPanel",
              "sembook:label": "Vocabulary",
              "sembook:scope": { "@id": "sembook:CumulativeScope" }
            },
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#merging-vocabularies-local-graph",
              "@type": "sembook:GraphPanel",
              "sembook:label": "Local Graph",
              "sembook:scope": { "@id": "sembook:LocalScope" },
              "sembook:sparql": "SELECT ?s ?p ?o WHERE { GRAPH ?g { ?s ?p ?o } VALUES ?g { <https://notebook.semantic.consulting/notebook1/#merging-vocabularies> } }"
            },
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#merging-vocabularies-full-graph",
              "@type": "sembook:GraphPanel",
              "sembook:label": "Full Graph",
              "sembook:scope": { "@id": "sembook:CumulativeScope" },
              "sembook:sparql": "SELECT ?s ?p ?o WHERE { GRAPH ?g { ?s ?p ?o } VALUES ?g { <https://notebook.semantic.consulting/notebook1/#merging-vocabularies> } }"
            }
          ]
        }
      ]
    },
    {
      "@id": "https://notebook.semantic.consulting/notebook1/#integration-for-free",
      "@type": "sembook:Lab",
      "sembook:label": "Integration for Free",
      "sembook:cssClass": "grid grid-rows-[40vh_60vh] h-screen w-full",
      "sembook:init": {},
      "sembook:panels": [
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#integration-for-free-record",
          "@type": "sembook:JsonLdPanel",
          "sembook:label": "DBpedia Record (Fetch it)",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:initialContent": "{}",
          "sembook:fetchUrl": "../datasets/elizabeth-dbpedia.jsonld"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#integration-for-free-tabs",
          "@type": "sembook:TabsPanel",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:panels": [
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#integration-for-free-local-graph",
              "@type": "sembook:GraphPanel",
              "sembook:label": "Local Graph",
              "sembook:scope": { "@id": "sembook:LocalScope" },
              "sembook:sparql": "SELECT ?s ?p ?o WHERE { GRAPH ?g { ?s ?p ?o } VALUES ?g { <https://notebook.semantic.consulting/notebook1/#integration-for-free> } }"
            },
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#integration-for-free-entities",
              "@type": "sembook:EntityPanel",
              "sembook:label": "Entities",
              "sembook:defaultScope": "all",
              "sembook:scope": { "@id": "sembook:CumulativeScope" },
              "sembook:sparql": "SELECT DISTINCT ?class ?parentClass ?instance ?instanceLabel ?classLabel WHERE { GRAPH ?g { VALUES ?g { <https://notebook.semantic.consulting/notebook1/#integration-for-free> } { { ?anyInstance a ?class } UNION { ?class a <http://www.w3.org/2000/01/rdf-schema#Class> } UNION { ?class a <http://www.w3.org/2002/07/owl#Class> } UNION { ?class <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?anyParent } UNION { ?anySub <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?class } } FILTER(!isBlank(?class)) FILTER(!STRSTARTS(STR(?class), \"https://notebook.semantic.consulting/vocab#\")) OPTIONAL { ?class <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?parentClass . FILTER(!STRSTARTS(STR(?parentClass), \"https://notebook.semantic.consulting/vocab#\")) } OPTIONAL { ?instance a ?class . FILTER(!isBlank(?instance)) OPTIONAL { ?instance <http://www.w3.org/2000/01/rdf-schema#label> ?instanceLabel } } OPTIONAL { ?class <http://www.w3.org/2000/01/rdf-schema#label> ?classLabel } } }"
            },
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#integration-for-free-vocabulary",
              "@type": "sembook:VocabularyPanel",
              "sembook:label": "Vocabulary",
              "sembook:scope": { "@id": "sembook:CumulativeScope" }
            }
          ]
        }
      ]
    },
    {
      "@id": "https://notebook.semantic.consulting/notebook1/#nature-of-relationships",
      "@type": "sembook:Lab",
      "sembook:label": "The Nature of Relationships",
      "sembook:cssClass": "grid grid-cols-2 grid-rows-[40vh_60vh] h-screen w-full",
      "sembook:init": {},
      "sembook:panels": [
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#nature-of-relationships-data",
          "@type": "sembook:TurtleWriterPanel",
          "sembook:label": "Data",
          "sembook:cssClass": "col-span-1 overflow-hidden flex flex-col sem-divider-r",
          "sembook:initialContent": "@prefix ex: <https://example.com/ns#> .\n\n# ── Our data ── three facts about Michael. That is all we are going to say.\n\n<https://w3id.org/people/michael>\n    ex:marriedTo     ex:kate ;\n    ex:bestFriendOf  ex:draco ;\n    ex:authorOf      <https://catalog.example.net/book/979-8868804090> .\n"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#nature-of-relationships-semantics",
          "@type": "sembook:TurtleWriterPanel",
          "sembook:label": "Semantics",
          "sembook:cssClass": "col-span-1 overflow-hidden flex flex-col",
          "sembook:initialContent": "@prefix ex: <https://example.com/ns#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n@prefix dbo: <https://dbpedia.org/ontology/> .\n\n# ── Our ontology ── what do these relationships MEAN?\n#\n# ex:marriedTo: if Michael is married to Kate, is Kate married to Michael?\n#   And ex:bestFriendOf: is Michael Draco's best friend? Should it be?\n#\n# ex:authorOf and ex:author: the same relationship, read from opposite ends.\n#   Some of our data says \"this book has an author.\" Some says \"this person wrote a book.\"\n#\n# dbo:spouse: DBpedia's word for the same thing as ex:marriedTo.\n#   Philip and Elizabeth have been in the graph since Lab 9.\n"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#nature-of-relationships-tabs",
          "@type": "sembook:TabsPanel",
          "sembook:cssClass": "col-span-2 overflow-hidden flex flex-col",
          "sembook:panels": [
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#nature-of-relationships-local-graph",
              "@type": "sembook:GraphPanel",
              "sembook:label": "Local Graph",
              "sembook:scope": { "@id": "sembook:LocalScope" },
              "sembook:sparql": "SELECT ?s ?p ?o WHERE { GRAPH ?g { ?s ?p ?o } VALUES ?g { <https://notebook.semantic.consulting/notebook1/#nature-of-relationships> } }"
            }
          ]
        }
      ]
    },
    {
      "@id": "https://notebook.semantic.consulting/notebook1/#transitivity",
      "@type": "sembook:Lab",
      "sembook:label": "Transitivity",
      "sembook:cssClass": "grid grid-cols-2 grid-rows-[40vh_60vh] h-screen w-full",
      "sembook:init": {},
      "sembook:panels": [
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#transitivity-data",
          "@type": "sembook:TurtleWriterPanel",
          "sembook:label": "Data",
          "sembook:cssClass": "col-span-1 overflow-hidden flex flex-col sem-divider-r",
          "sembook:initialContent": "@prefix ex: <https://example.com/ns#> .\n@prefix schema: <http://schema.org/> .\n@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .\n\n# ── Our data ── one conference, one hotel, one performer.\n\n<https://uberconf.com> a schema:EducationalEvent ;\n    rdfs:label \"UberConf\" ;\n    schema:performer <https://w3id.org/people/michael> ;\n    schema:location ex:HyattWestminster .\n\nex:HyattWestminster a schema:Hotel ;\n    rdfs:label \"Hyatt Westminster\" ;\n    ex:locatedIn ex:Westminster .\n\nex:Westminster rdfs:label \"Westminster\" ;\n    ex:locatedIn ex:Colorado ;\n    ex:locatedIn ex:DenverMetro .\n\nex:Colorado rdfs:label \"Colorado\" .\nex:DenverMetro rdfs:label \"Denver\" .\n\n<https://w3id.org/people/michael> ex:locatedIn ex:HyattWestminster .\n"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#transitivity-semantics",
          "@type": "sembook:TurtleWriterPanel",
          "sembook:label": "Semantics",
          "sembook:cssClass": "col-span-1 overflow-hidden flex flex-col",
          "sembook:initialContent": "@prefix ex: <https://example.com/ns#> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n\n# ── Our ontology ──\n#\n# If I am in the hotel, and the hotel is in the city,\n# and the city is in the state… where am I?\n#\n# The graph does not know yet. Teach it what \"located in\" means.\n"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#transitivity-tabs",
          "@type": "sembook:TabsPanel",
          "sembook:cssClass": "col-span-2 overflow-hidden flex flex-col",
          "sembook:panels": [
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#transitivity-local-graph",
              "@type": "sembook:GraphPanel",
              "sembook:label": "Local Graph",
              "sembook:scope": { "@id": "sembook:LocalScope" },
              "sembook:sparql": "SELECT ?s ?p ?o WHERE { GRAPH ?g { ?s ?p ?o } VALUES ?g { <https://notebook.semantic.consulting/notebook1/#transitivity> } }"
            }
          ]
        }
      ]
    },
    {
      "@id": "https://notebook.semantic.consulting/notebook1/#semantic-alignment",
      "@type": "sembook:Lab",
      "sembook:label": "Semantic Alignment",
      "sembook:cssClass": "grid grid-cols-2 grid-rows-[40vh_60vh] h-screen w-full",
      "sembook:init": {},
      "sembook:panels": [
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#semantic-alignment-catalog",
          "@type": "sembook:JsonLdPanel",
          "sembook:label": "Catalog Record (Fetch it)",
          "sembook:cssClass": "col-span-1 overflow-hidden flex flex-col sem-divider-r",
          "sembook:initialContent": "{}",
          "sembook:fetchUrl": "../datasets/elizabeth-catalog-record.jsonld"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#semantic-alignment-semantics",
          "@type": "sembook:TurtleWriterPanel",
          "sembook:label": "Semantics",
          "sembook:cssClass": "col-span-1 overflow-hidden flex flex-col",
          "sembook:initialContent": "@prefix schema: <http://schema.org/> .\n@prefix owl: <http://www.w3.org/2002/07/owl#> .\n\n# ── Our ontology ──\n#\n# Two records. Two systems. No shared identifier.\n#\n# But an ISBN identifies exactly one book —\n# whoever holds it, however they spell the property.\n#\n# Say that. Precisely.\n"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#semantic-alignment-tabs",
          "@type": "sembook:TabsPanel",
          "sembook:cssClass": "col-span-2 overflow-hidden flex flex-col",
          "sembook:panels": [
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#semantic-alignment-local-graph",
              "@type": "sembook:GraphPanel",
              "sembook:label": "Local Graph",
              "sembook:scope": { "@id": "sembook:LocalScope" },
              "sembook:sparql": "SELECT ?s ?p ?o WHERE { GRAPH ?g { ?s ?p ?o } VALUES ?g { <https://notebook.semantic.consulting/notebook1/#semantic-alignment> } }"
            },
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#semantic-alignment-full-graph",
              "@type": "sembook:GraphPanel",
              "sembook:label": "Full Graph",
              "sembook:scope": { "@id": "sembook:CumulativeScope" },
              "sembook:sparql": "SELECT ?s ?p ?o WHERE { GRAPH ?g { ?s ?p ?o } VALUES ?g { <https://notebook.semantic.consulting/notebook1/#semantic-alignment> } }"
            },
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#semantic-alignment-entities",
              "@type": "sembook:EntityPanel",
              "sembook:label": "Entities",
              "sembook:scope": { "@id": "sembook:CumulativeScope" },
              "sembook:sparql": "SELECT DISTINCT ?class ?parentClass ?instance ?instanceLabel ?classLabel WHERE { GRAPH ?g { VALUES ?g { <https://notebook.semantic.consulting/notebook1/#semantic-alignment> } { { ?anyInstance a ?class } UNION { ?class a <http://www.w3.org/2000/01/rdf-schema#Class> } UNION { ?class a <http://www.w3.org/2002/07/owl#Class> } UNION { ?class <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?anyParent } UNION { ?anySub <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?class } } FILTER(!isBlank(?class)) FILTER(!STRSTARTS(STR(?class), \"https://notebook.semantic.consulting/vocab#\")) OPTIONAL { ?class <http://www.w3.org/2000/01/rdf-schema#subClassOf> ?parentClass . FILTER(!STRSTARTS(STR(?parentClass), \"https://notebook.semantic.consulting/vocab#\")) } OPTIONAL { ?instance a ?class . FILTER(!isBlank(?instance)) OPTIONAL { ?instance <http://www.w3.org/2000/01/rdf-schema#label> ?instanceLabel } } OPTIONAL { ?class <http://www.w3.org/2000/01/rdf-schema#label> ?classLabel } } }"
            },
            {
              "@id": "https://notebook.semantic.consulting/notebook1/#semantic-alignment-vocabulary",
              "@type": "sembook:VocabularyPanel",
              "sembook:label": "Vocabulary",
              "sembook:scope": { "@id": "sembook:CumulativeScope" }
            }
          ]
        }
      ]
    },
    {
      "@id": "https://notebook.semantic.consulting/notebook1/#querying-the-graph",
      "@type": "sembook:Lab",
      "sembook:label": "Querying the Graph",
      "sembook:cssClass": "grid grid-rows-[40vh_60vh] h-screen w-full",
      "sembook:init": {},
      "sembook:panels": [
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#querying-the-graph-editor",
          "@type": "sembook:SparqlPanel",
          "sembook:label": "SPARQL",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:sampleQueries": [
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "1 · It's all triples",
              "sembook:sparql": "SELECT ?s ?p ?o WHERE {\n  ?s ?p ?o\n}"
            },
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "2 · Books — in our vocabulary",
              "sembook:sparql": "PREFIX ex: <https://example.com/ns#>\nPREFIX owl: <http://www.w3.org/2002/07/owl#>\n\n# Two rows, one book. SPARQL does not collapse owl:sameAs;\n# the graph just tells you, on every row, who the book is the same as.\nSELECT ?book ?title ?sameAs WHERE {\n  ?book a ex:Book ;\n        ex:title ?title .\n  OPTIONAL { ?book owl:sameAs ?sameAs }\n}"
            },
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "3 · DESCRIBE Michael",
              "sembook:sparql": "DESCRIBE <https://w3id.org/people/michael>"
            },
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "4 · Books — in their vocabulary",
              "sembook:sparql": "PREFIX schema: <http://schema.org/>\n\nSELECT ?book ?name WHERE {\n  ?book a schema:Book ;\n        schema:name ?name .\n}"
            },
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "5 · Where is Michael?",
              "sembook:sparql": "PREFIX ex: <https://example.com/ns#>\nPREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>\n\n# We told the graph one hotel. No path expression, no recursion:\n# the reasoner already closed the chain, so the query stays simple.\nSELECT ?place ?label WHERE {\n  <https://w3id.org/people/michael> ex:locatedIn ?place .\n  OPTIONAL { ?place rdfs:label ?label }\n}"
            },
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "6 · Everything about Elizabeth — and who said it",
              "sembook:sparql": "SELECT ?source ?p ?o WHERE {\n  GRAPH ?source {\n    <https://dbpedia.org/resource/Elizabeth_II> ?p ?o\n  }\n}\nORDER BY ?source"
            },
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "7 · The same — without trusting DBpedia",
              "sembook:sparql": "SELECT ?source ?p ?o WHERE {\n  GRAPH ?source {\n    <https://dbpedia.org/resource/Elizabeth_II> ?p ?o\n  }\n  FILTER(?source NOT IN (\n    <https://notebook.semantic.consulting/notebook1/#integration-for-free>,\n    <https://notebook.semantic.consulting/notebook1/#integration-for-free-inferred>,\n    <https://notebook.semantic.consulting/notebook1/#nature-of-relationships-inferred>\n  ))\n}\nORDER BY ?source"
            },
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "8 · Query the notebook itself",
              "sembook:sparql": "# Scope note: naming a GRAPH anywhere (even here) widens this query\n# to the ENTIRE dataset — including the default graph, where the\n# notebook's own definition lives. You have been inside one all day.\nPREFIX sembook: <https://notebook.semantic.consulting/vocab#>\n\nSELECT ?lab ?label WHERE {\n  ?lab a sembook:Lab ;\n       sembook:label ?label .\n}"
            }
          ]
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#querying-the-graph-result",
          "@type": "sembook:SparqlResultPanel",
          "sembook:label": "Result",
          "sembook:cssClass": "overflow-hidden flex flex-col"
        }
      ]
    },
    {
      "@id": "https://notebook.semantic.consulting/notebook1/#contexts-on-the-fly",
      "@type": "sembook:Lab",
      "sembook:label": "Contexts on the Fly",
      "sembook:cssClass": "grid grid-rows-[40vh_60vh] h-screen w-full",
      "sembook:init": {},
      "sembook:panels": [
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#contexts-on-the-fly-editor",
          "@type": "sembook:SparqlPanel",
          "sembook:label": "SPARQL",
          "sembook:cssClass": "overflow-hidden flex flex-col",
          "sembook:sampleQueries": [
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "1 · Invent a vocabulary — right now",
              "sembook:sparql": "PREFIX schema: <http://schema.org/>\n\nCONSTRUCT {\n  ?p <https://example.com/reporting#displayName> ?name .\n} WHERE {\n  ?p a schema:Person ;\n     schema:name ?name .\n}"
            },
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "2 · Define a new class on the fly",
              "sembook:sparql": "PREFIX ex: <https://example.com/ns#>\n\nCONSTRUCT {\n  ?book a <https://example.com/reporting#TwentiethCenturyBook> .\n} WHERE {\n  ?book ex:published ?year .\n  FILTER(?year < 2000)\n}"
            }
          ]
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#contexts-on-the-fly-result",
          "@type": "sembook:SparqlResultPanel",
          "sembook:label": "Result",
          "sembook:cssClass": "overflow-hidden flex flex-col"
        }
      ]
    },
    {
      "@id": "https://notebook.semantic.consulting/notebook1/#who-said-that",
      "@type": "sembook:Lab",
      "sembook:label": "Who Said That?",
      "sembook:cssClass": "grid grid-cols-2 grid-rows-[40vh_60vh] h-screen w-full",
      "sembook:init": {},
      "sembook:panels": [
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#who-said-that-record",
          "@type": "sembook:JsonLdPanel",
          "sembook:label": "CelebWatch Record (Fetch it)",
          "sembook:cssClass": "col-span-1 overflow-hidden flex flex-col sem-divider-r",
          "sembook:initialContent": "{}",
          "sembook:fetchUrl": "../datasets/elizabeth-gossip-record.jsonld"
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#who-said-that-sparql",
          "@type": "sembook:SparqlPanel",
          "sembook:label": "SPARQL",
          "sembook:cssClass": "col-span-1 overflow-hidden flex flex-col",
          "sembook:sampleQueries": [
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "1 · When was Elizabeth born?",
              "sembook:sparql": "PREFIX schema: <http://schema.org/>\n\nSELECT DISTINCT ?birthDate WHERE {\n  <https://dbpedia.org/resource/Elizabeth_II> schema:birthDate ?birthDate .\n}"
            },
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "2 · …says who?",
              "sembook:sparql": "PREFIX schema: <http://schema.org/>\n\nSELECT ?source ?birthDate WHERE {\n  GRAPH ?source {\n    <https://dbpedia.org/resource/Elizabeth_II> schema:birthDate ?birthDate .\n  }\n}\nORDER BY ?source"
            },
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "3 · Only sources we trust",
              "sembook:sparql": "PREFIX schema: <http://schema.org/>\n\nSELECT ?source ?birthDate WHERE {\n  GRAPH ?source {\n    <https://dbpedia.org/resource/Elizabeth_II> schema:birthDate ?birthDate .\n  }\n  FILTER(?source NOT IN (\n    <https://notebook.semantic.consulting/notebook1/#who-said-that>,\n    <https://notebook.semantic.consulting/notebook1/#who-said-that-inferred>\n  ))\n}\nORDER BY ?source"
            },
            {
              "@type": "sembook:SampleQuery",
              "sembook:label": "4 · What else did the tabloid claim?",
              "sembook:sparql": "SELECT ?s ?p ?o WHERE {\n  GRAPH <https://notebook.semantic.consulting/notebook1/#who-said-that> {\n    ?s ?p ?o .\n  }\n}"
            }
          ]
        },
        {
          "@id": "https://notebook.semantic.consulting/notebook1/#who-said-that-result",
          "@type": "sembook:SparqlResultPanel",
          "sembook:label": "Result",
          "sembook:cssClass": "col-span-2 overflow-hidden flex flex-col"
        }
      ]
    }
  ]
}
